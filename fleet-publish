#!/usr/bin/env bash
# fleet-publish -- expose a local port on the public HTTPS domain.
#
#   fleet-publish list
#   fleet-publish add NAME PORT [--target HOST]
#   fleet-publish rm NAME
#
# Why not just open the port in the firewall? Because that would be plain
# HTTP on a random port, and every extra open port is another thing exposed
# to the internet. Instead each service becomes a PATH on the domain Caddy
# already serves, so it inherits the existing TLS certificate and no new
# port is opened anywhere.
#
#   container on 127.0.0.1:8082  ->  https://<domain>/web/
set -uo pipefail

DIR=/etc/caddy/published
CADDY=/etc/caddy/Caddyfile
RESERVED="cockpit fleet api static assets base1 manifests.js login ping"

die() { echo "fleet-publish: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run with sudo"; }

domain() { grep -oE '^[a-z0-9.-]+\.[a-z]{2,}' "$CADDY" | head -1; }

cmd_list() {
    mkdir -p "$DIR"
    local any=0
    printf "%-16s %-22s %s\n" NAME TARGET URL
    for f in "$DIR"/*.caddy; do
        [ -e "$f" ] || continue
        any=1
        local n t
        n=$(basename "$f" .caddy)
        t=$(grep -oE 'reverse_proxy [^ ]+' "$f" | awk '{print $2}')
        printf "%-16s %-22s https://%s/%s/\n" "$n" "$t" "$(domain)" "$n"
    done
    [ "$any" = 0 ] && echo "(nothing published yet)"
    return 0
}

cmd_add() {
    need_root
    local name=${1:-} port=${2:-} target=127.0.0.1
    [ "${3:-}" = "--target" ] && target=${4:-127.0.0.1}
    [ -n "$name" ] && [ -n "$port" ] || die "usage: fleet-publish add NAME PORT [--target HOST]"
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "name must be lowercase letters, digits and dashes"
    [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "port must be 1-65535"
    for r in $RESERVED; do
        [ "$name" = "$r" ] && die "'$name' is reserved by the panel itself"
    done

    mkdir -p "$DIR"
    cat > "$DIR/$name.caddy" <<EOF
# published by fleet-publish
handle_path /$name* {
    reverse_proxy $target:$port
}
EOF

    if ! caddy validate --config "$CADDY" --adapter caddyfile >/dev/null 2>&1; then
        rm -f "$DIR/$name.caddy"
        die "Caddy rejected that config; nothing changed"
    fi
    systemctl reload caddy || die "caddy reload failed"
    echo "published: https://$(domain)/$name/  ->  $target:$port"
}

cmd_rm() {
    need_root
    local name=${1:-}
    [ -n "$name" ] || die "usage: fleet-publish rm NAME"
    [ -f "$DIR/$name.caddy" ] || die "'$name' is not published"
    rm -f "$DIR/$name.caddy"
    caddy validate --config "$CADDY" --adapter caddyfile >/dev/null 2>&1 \
        || die "config invalid after removal -- check $CADDY by hand"
    systemctl reload caddy || die "caddy reload failed"
    echo "unpublished: $name"
}

# ports that something is actually listening on, for the UI to offer
cmd_ports() {
    ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' | sort -un \
      | grep -vE '^(22|80|443|9090|8765|44321)$'
}

case "${1:-list}" in
    list)  shift; cmd_list "$@" ;;
    add)   shift; cmd_add "$@" ;;
    rm)    shift; cmd_rm "$@" ;;
    ports) shift; cmd_ports "$@" ;;
    *)     die "usage: fleet-publish {list|add|rm|ports}" ;;
esac