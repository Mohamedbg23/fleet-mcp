#!/usr/bin/env bash
# Add a server to the fleet. No code editing, no restart -- hosts.json is
# hot-reloaded by the running server.
#
#   fleet-add <name> <ip-or-host> [ssh-key-you-already-use] [--harden] [--keepalive]
#
# The key argument is only needed once, to install the fleet key on the new
# box. After that the fleet key is what's used.
set -euo pipefail

NAME="${1:-}"; ADDR="${2:-}"; SEED="${3:-}"
[ -n "$NAME" ] && [ -n "$ADDR" ] || {
  echo "usage: fleet-add <name> <ip> [existing-ssh-key] [--harden] [--keepalive]" >&2; exit 1; }

CONF=/etc/mcp-fleet/hosts.json
KEY="${FLEET_KEY:-$HOME/.ssh/fleet}"
USER_="${FLEET_USER:-ubuntu}"
HARDEN=0; KEEPALIVE=0
for a in "$@"; do
  [ "$a" = "--harden" ] && HARDEN=1
  [ "$a" = "--keepalive" ] && KEEPALIVE=1
done
[ -f "$KEY.pub" ] || { echo "no fleet key at $KEY.pub -- run install.sh first" >&2; exit 1; }
PUB="$(cat "$KEY.pub")"

echo "==> installing fleet key on $NAME ($ADDR)"
if ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
       "$USER_@$ADDR" true 2>/dev/null; then
  echo "    already trusted"
else
  [ -n "$SEED" ] || { echo "    cannot reach it yet; pass the key you normally use as arg 3" >&2; exit 1; }
  ssh -i "$SEED" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$USER_@$ADDR" \
    "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && grep -qxF '$PUB' ~/.ssh/authorized_keys || echo '$PUB' >> ~/.ssh/authorized_keys"
  echo "    key installed"
fi

echo "==> registering in $CONF"
python3 - "$CONF" "$NAME" "$ADDR" <<'PY'
import json, sys
conf, name, addr = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    d = json.load(open(conf))
except Exception:
    d = {}
d[name] = addr
json.dump(d, open(conf, "w"), indent=0)
print("    hosts:", ", ".join(sorted(d)))
PY

if [ "$HARDEN" = 1 ]; then
  echo "==> hardening sshd on $NAME"
  scp -q -i "$KEY" /usr/local/bin/harden-ssh.sh "$USER_@$ADDR:/tmp/h.sh"
  ssh -i "$KEY" "$USER_@$ADDR" "sudo bash /tmp/h.sh; rm -f /tmp/h.sh"
fi
if [ "$KEEPALIVE" = 1 ]; then
  echo "==> installing idle guard on $NAME"
  scp -q -i "$KEY" /usr/local/bin/oci-keepalive.sh "$USER_@$ADDR:/tmp/k.sh"
  ssh -i "$KEY" "$USER_@$ADDR" "sudo install -m755 /tmp/k.sh /usr/local/bin/oci-keepalive.sh; rm -f /tmp/k.sh; sudo tee /etc/systemd/system/oci-keepalive.service >/dev/null <<'U'
[Unit]
Description=Always Free idle-reclamation guard
After=network-online.target
[Service]
ExecStart=/usr/local/bin/oci-keepalive.sh
Restart=always
RestartSec=10
Nice=19
CPUWeight=1
[Install]
WantedBy=multi-user.target
U
sudo systemctl daemon-reload && sudo systemctl enable --now oci-keepalive"
fi

echo "==> verifying"
ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=10 "$USER_@$ADDR" hostname
echo "done -- '$NAME' is now part of on=all. No restart needed."